// @cheshire
// ad: Do more
// yazar: Claude
// param tema "Tema": kömür [kömür, çam, gece, kahve, kor]
// param boyut "Yazı boyutu": 1.0 [0.7, 1.3]
// param yirmidort "24 saat": açık
// param tane "Film tanesi": 1.0 [0, 2]
//
// Kağıt kesimi gibi üst üste binen katmanlar: solda iç içe yuvarlak dikdörtgenler, sağda
// yarım daireli bir pist. Her katman bir alttakine gölge düşürür. Ortada saat ve altında
// "DO MORE." 5 hazır tema: kömür, çam, gece, kahve, kor.
// Yazı gerçek font: Montserrat'ın (SIL OFL 1.1) glif konturları kuadratik Bézier parçaları
// olarak gömülü. buf A bu veriyi her karede bir dokuya yazar (FXC sabit dizili döngüleri
// açmaya kalkıp çöküyor; dokudan okumak onu döngü olarak bırakır). image her piksel için en
// yakın eğriye tam uzaklığı ve sarma sayısını hesaplar, kenarı bir piksel içinde yumuşatır.
// Doku 16 bit float olduğu için koordinatlar kaba + ince iki parça olarak saklanır.
// Yalnızca iDate okunduğu için saniyede bir kare çizilir.
// `yirmidort` kapalıysa 12 saatlik gösterim.

//--- ortak
// Glif sırası: 0-9, ':', D, O, M, R, E, '.'
const int G_COLON = 10, G_D = 11, G_O = 12, G_M = 13, G_R = 14, G_E = 15, G_DOT = 16;

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float dot2(vec2 v) { return dot(v, v); }

float sdSegment(vec2 p, vec2 a, vec2 b) {
    vec2 pa = p - a, ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h);
}

// Kuadratik Bézier'e uzaklık (iq). Düz parçalar (kontrol noktası ortada) ayrıca ele alınır.
float sdBezier(vec2 pos, vec2 A, vec2 B, vec2 C) {
    vec2 a = B - A, b = A - 2.0 * B + C, c = a * 2.0, d = A - pos;
    if (dot(b, b) < 1e-7) return sdSegment(pos, A, C);
    float kk = 1.0 / dot(b, b);
    float kx = kk * dot(a, b);
    float ky = kk * (2.0 * dot(a, a) + dot(d, b)) / 3.0;
    float kz = kk * dot(d, a);
    float p = ky - kx * kx, p3 = p * p * p;
    float q = kx * (2.0 * kx * kx - 3.0 * ky) + kz;
    float h = q * q + 4.0 * p3;
    float res;
    if (h >= 0.0) {
        h = sqrt(h);
        vec2 x = (vec2(h, -h) - q) / 2.0;
        vec2 uv = sign(x) * pow(abs(x), vec2(1.0 / 3.0));
        float t = clamp(uv.x + uv.y - kx, 0.0, 1.0);
        res = dot2(d + (c + b * t) * t);
    } else {
        float z = sqrt(-p);
        float v = acos(q / (p * z * 2.0)) / 3.0;
        float m = cos(v), n = sin(v) * 1.732050808;
        vec3 t = clamp(vec3(m + m, -n - m, n - m) * z - kx, 0.0, 1.0);
        res = min(dot2(d + (c + b * t.x) * t.x), dot2(d + (c + b * t.y) * t.y));
    }
    return sqrt(res);
}

// p'den sağa giden yatay ışının parçayı kaç kez (yönlü) kestiği: sarma sayısı için.
int crossings(vec2 p, vec2 A, vec2 B, vec2 C) {
    vec2 a = A - 2.0 * B + C, b = 2.0 * (B - A), c = A - p;
    int w = 0;
    if (abs(a.y) < 1e-6) {
        if (abs(b.y) < 1e-9) return 0;
        float t = -c.y / b.y;
        if (t >= 0.0 && t < 1.0 && (a.x * t + b.x) * t + c.x > 0.0) w += b.y > 0.0 ? 1 : -1;
        return w;
    }
    float disc = b.y * b.y - 4.0 * a.y * c.y;
    if (disc < 0.0) return 0;
    float q = -0.5 * (b.y + (b.y >= 0.0 ? 1.0 : -1.0) * sqrt(disc));
    float t1 = q / a.y;
    float t2 = abs(q) > 1e-12 ? c.y / q : t1;
    if (t1 >= 0.0 && t1 < 1.0 && (a.x * t1 + b.x) * t1 + c.x > 0.0) w += (2.0 * a.y * t1 + b.y) > 0.0 ? 1 : -1;
    if (t2 != t1 && t2 >= 0.0 && t2 < 1.0 && (a.x * t2 + b.x) * t2 + c.x > 0.0) w += (2.0 * a.y * t2 + b.y) > 0.0 ? 1 : -1;
    return w;
}

// ---------- Fon ----------
float sdRBox(vec2 p, vec2 c, vec2 b, float r) {
    vec2 q = abs(p - c) - b + r;
    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
}

// Pist: cB merkezli yarım daire, sağa doğru sonsuz. İçeride negatif.
float sdTrack(vec2 p, vec2 cB, float R) {
    vec2 q = p - cB;
    return length(vec2(min(q.x, 0.0), q.y)) - R;
}

void theme(int i, out vec3 a, out vec3 b, out vec3 ink) {
    if (i == 1)      { a = vec3(0.070, 0.085, 0.078); b = vec3(0.235, 0.345, 0.275); ink = vec3(0.95, 0.96, 0.93); } // çam
    else if (i == 2) { a = vec3(0.055, 0.070, 0.115); b = vec3(0.160, 0.205, 0.330); ink = vec3(0.93, 0.94, 0.98); } // gece
    else if (i == 3) { a = vec3(0.330, 0.255, 0.205); b = vec3(0.640, 0.530, 0.430); ink = vec3(0.98, 0.97, 0.95); } // kahve
    else if (i == 4) { a = vec3(0.080, 0.078, 0.078); b = vec3(0.870, 0.300, 0.115); ink = vec3(0.98, 0.97, 0.96); } // kor
    else             { a = vec3(0.075, 0.075, 0.077); b = vec3(0.135, 0.135, 0.140); ink = vec3(0.96, 0.96, 0.95); } // kömür
}

// Bir katmanın tonu: k. basamak, basamak içinde f (0 iç kenar, 1 dış kenar).
// Üstteki katman iç kenara sıkı bir temas gölgesi ve daha geniş, hafif bir gölge düşürür;
// dış kenar ışığı yakalayıp incecik parlar.
float stepTone(float k, float f, float bw) {
    float contact = exp(-f * bw / 0.0055);
    float ambient = exp(-f * bw / 0.022);
    float rim = exp(-(1.0 - f) * bw / 0.0025);
    return (1.0 + 0.045 * k + 0.03 * f) * (1.0 - 0.42 * contact - 0.22 * ambient) + 0.06 * rim;
}

// Katman yığını: u çekirdek kenarından dışa mesafe (<0 çekirdek). Basamak kenarları keskin
// süreksizliklerdir; piksel örtüsüne göre iki yan karıştırılır.
vec3 stack(float u, vec3 base, float bw, float px) {
    float k = floor(u / bw), f = fract(u / bw);
    float v, next, prev, toNext, toPrev;
    float core = 1.06;
    if (u < 0.0) {
        v = core + 0.06 * exp(u / 0.0025); next = stepTone(0.0, 0.0, bw); prev = v;
        toNext = -u; toPrev = bw;
    } else {
        v = stepTone(k, f, bw);
        next = stepTone(k + 1.0, 0.0, bw);
        prev = k == 0.0 ? core + 0.06 : stepTone(k - 1.0, 1.0, bw);
        toNext = (1.0 - f) * bw; toPrev = f * bw;
    }
    v = mix(next, v, clamp(toNext / px + 0.5, 0.0, 1.0));
    v = mix(prev, v, clamp(toPrev / px + 0.5, 0.0, 1.0));
    return base * v;
}

