// @cheshire
// ad: Haze
// ad.tr: Pus
// yazar: Claude
// fps: 30
// param palet "Palette" "Palet": clay [clay/kil, sage/adaçayı, dusk/alacakaranlık, mono/gri]
// param hiz "Speed" "Hız": 1.0 [0.2, 3]
// param tane "Film grain" "Film tanesi": 1.0 [0, 2]
//
// Yavaşça süzülen, birbirine karışan yumuşak ışık bulutları (2026'nın "soft glow" gradyanları).
// Dört bulut Lissajous yollarında dolaşır; alan hafifçe bükülür, böylece kenarlar hiç sabit
// kalmaz. Paletler sıcak toprak tonları: kil (terrakota, karamel, zeytin), adaçayı, alacakaranlık
// ve gri. Üstüne hareketli ince film tanesi.

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

void palette(int p, out vec3 bg, out vec3 c1, out vec3 c2, out vec3 c3) {
    if (p == 0) {
        bg = vec3(0.075, 0.050, 0.040);
        c1 = vec3(0.780, 0.400, 0.270);
        c2 = vec3(0.880, 0.660, 0.420);
        c3 = vec3(0.430, 0.450, 0.280);
    } else if (p == 1) {
        bg = vec3(0.045, 0.060, 0.052);
        c1 = vec3(0.520, 0.640, 0.500);
        c2 = vec3(0.830, 0.800, 0.640);
        c3 = vec3(0.260, 0.400, 0.380);
    } else if (p == 2) {
        bg = vec3(0.045, 0.035, 0.080);
        c1 = vec3(0.850, 0.440, 0.540);
        c2 = vec3(0.980, 0.690, 0.450);
        c3 = vec3(0.380, 0.330, 0.740);
    } else {
        bg = vec3(0.050);
        c1 = vec3(0.520);
        c2 = vec3(0.820);
        c3 = vec3(0.280);
    }
}

// Yumuşak, kenarsız bulut: merkezden uzaklıkla Gauss gibi söner.
float cloud(vec2 uv, vec2 c, float r) {
    vec2 d = uv - c;
    return exp(-dot(d, d) / (r * r));
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;
    float t = iTime * 0.05 * hiz;

    // Alanı hafifçe bük: bulut kenarları sürekli akar.
    vec2 w = uv + 0.09 * vec2(sin(uv.y * 3.1 + t * 2.3), cos(uv.x * 2.7 - t * 1.9));
    w += 0.04 * vec2(sin(uv.x * 5.3 - t * 3.1), cos(uv.y * 4.7 + t * 2.6));

    vec3 bg, c1, c2, c3;
    palette(int(palet + 0.5), bg, c1, c2, c3);

    // Yollar ekrana yayılmış ve faz farklı: bulutlar bir köşede toplanmaz.
    float a = cloud(w, vec2(0.60 * sin(t * 1.3), 0.25 * cos(t * 1.1)), 0.40);
    float b = cloud(w, vec2(0.62 * cos(t * 0.9 + 2.0), 0.28 * sin(t * 1.7 + 1.0)), 0.36);
    float c = cloud(w, vec2(0.55 * sin(t * 0.7 + 4.0), 0.25 * cos(t * 1.3 + 3.0)), 0.34);
    float d = cloud(w, vec2(0.66 * cos(t * 1.1 + 5.5), 0.22 * sin(t * 0.8 + 0.5)), 0.32);

    // Işık gibi üst üste binsin (screen): kesişimler çamurlaşmadan parlar.
    vec3 col = bg;
    col = 1.0 - (1.0 - col) * (1.0 - c1 * a * 0.95);
    col = 1.0 - (1.0 - col) * (1.0 - c2 * b * 0.85);
    col = 1.0 - (1.0 - col) * (1.0 - c3 * c * 0.90);
    col = 1.0 - (1.0 - col) * (1.0 - mix(c1, c2, 0.4) * d * 0.70);
    // Hafif kontrast: zemin koyu kalsın, ışıklar öne çıksın.
    col = pow(col, vec3(1.15));

    // Üstten gelen hafif ışık, kenarlarda vinyet.
    col *= 0.85 + 0.25 * smoothstep(-0.6, 0.6, uv.y);
    col *= 1.0 - 0.25 * dot(uv, uv);

    // Hareketli film tanesi: düz gradyanların bantlaşmasını da gizler.
    col += (hash12(fragCoord + fract(iTime) * 113.0) - 0.5) * 0.045 * tane;
    fragColor = vec4(col, 1.0);
}
