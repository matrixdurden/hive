// @cheshire
// ad: Flow
// ad.tr: Akış
// yazar: Claude
// fps: 60
// param hiz "Speed" "Hız": 1.0 [0.2, 3]
// param iz "Trail length" "İz uzunluğu": 0.9 [0.8, 0.97]
// param yogunluk "Density" "Yoğunluk": 1.0 [0.3, 3]
//
// Zamanla kıvrılan bir gürültü alanında akan renkli lifler.
// Teknik: IBFV (image-based flow visualization, van Wijk 2002). Buf A her karede önceki
// kareyi alan boyunca bir adım taşır ve üstüne seyrek, yanıp sönen gürültüyü azıcık karıştırır;
// taşıma + karıştırma gürültüyü akış çizgileri boyunca biriktirip hareketli liflere dönüştürür.
// `iz` karışımda eski karenin payıdır: yükseldikçe lifler uzar. Fare lifleri dışa iter.

//--- ortak
float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float hash13(vec3 p) {
    return hash12(p.xy + p.z * 57.0);
}

float vnoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);
    float a = mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), u.x),
                  mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), u.x), u.y);
    float b = mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), u.x),
                  mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), u.x), u.y);
    return mix(a, b, u.z);
}

// Birim yönlü akış alanı. Ölçek yüksekliğe bağlı: her çözünürlükte aynı görünür.
vec2 field(vec2 p, float t) {
    vec3 q = vec3(p * 2.2 / iResolution.y, t * 0.04);
    float n = vnoise(q) * 0.7 + vnoise(q * 2.03 + 11.0) * 0.3;
    float a = n * 12.566;
    return vec2(cos(a), sin(a));
}

vec3 hsv(float h, float s, float v) {
    vec3 k = mod(vec3(5.0, 3.0, 1.0) + h / 60.0, 6.0);
    return v - v * s * clamp(min(k, 4.0 - k), 0.0, 1.0);
}

//--- buf A
void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    float k = min(iTimeDelta, 0.1) * 60.0; // 60 FPS'e göre adım
    vec2 v = field(fragCoord, iTime) * 1.5 * hiz;

    if (iMouse.x > 0.0) {
        vec2 d = fragCoord - iMouse.xy;
        float r = length(d);
        v += d / max(r, 1.0) * max(0.0, 1.0 - r / 160.0) * 4.0;
    }

    vec2 src = fragCoord - v * k;
    bool inside = src.x >= 0.0 && src.y >= 0.0 && src.x < iResolution.x && src.y < iResolution.y;
    vec3 prev = inside ? texture(iChannel0, src / iResolution.xy).rgb : vec3(0.0);

    // Seyrek gürültü: 2x2 piksellik hücrelerin küçük bir kısmı, kendi fazıyla yanıp söner.
    vec2 cell = floor(fragCoord / 2.0);
    float pick = hash12(cell);
    float phase = hash12(cell + 71.3);
    float on = step(1.0 - 0.045 * yogunluk, pick) * step(0.5, fract(iTime * 0.7 + phase));
    float hue = 200.0 + fragCoord.x / iResolution.x * 140.0 + iTime * 3.0;
    vec3 noise = hsv(mod(hue, 360.0), 0.75, 1.0) * on;

    float keep = pow(iz, k);
    fragColor = vec4(prev * keep + noise * (1.0 - keep), 1.0);
}

//--- image
void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    vec3 c = texture(iChannel0, fragCoord / iResolution.xy).rgb;
    vec3 bg = vec3(0.045, 0.045, 0.07);
    fragColor = vec4(bg + 1.0 - exp(-c * 3.0), 1.0);
}
