// 16 bit float dokuda tam hassasiyet: kaba kısım 1/1024'ün tam katı, ince kısım kalan.
float hiPart(float v) { return floor(v * 1024.0 + 0.5) / 1024.0; }
float loPart(float v) { return (v - hiPart(v)) * 1024.0; }

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    int W = int(iResolution.x);
    int i = int(fragCoord.y) * W + int(fragCoord.x);
    vec4 v = vec4(0.0);
    if (i < GP_N) {
        vec2 p = gp(i);
        v = vec4(hiPart(p.x), loPart(p.x), hiPart(p.y), loPart(p.y));
    } else if (i >= 2048 && i < 2048 + GLYPH_N) {
        vec3 m = gm(i - 2048);
        v = vec4(m.x, m.y, hiPart(m.z), loPart(m.z));
    } else if (i >= 2112 && i < 2112 + GLYPH_N) {
        v = gb(i - 2112);
    } else if (i >= 2176 && i < 2176 + SG_N) {
        v = vec4(sg(i - 2176), 0.0, 0.0, 0.0);
    }
    fragColor = v;
}

//--- image
// Doku okuyan her şey burada: ortak ya da buf A'da iChannel geçseydi motor geri besleme sayıp
// sürekli çizerdi.
// buf A'daki düz dizin → doku texeli.
vec4 fetchA(int i) {
    int W = int(iChannelResolution[0].x);
    return texelFetch(iChannel0, ivec2(i % W, i / W), 0);
}
float fine(float hi, float lo) { return hi + lo / 1024.0; }
vec2 pt(int i) { vec4 v = fetchA(i); return vec2(fine(v.x, v.y), fine(v.z, v.w)); }
// (başlangıç parçası, parça sayısı, ilerleme)
vec3 meta(int g) { vec4 v = fetchA(2048 + g); return vec3(v.x, v.y, fine(v.z, v.w)); }
vec4 bbox(int g) { return fetchA(2112 + g); }
// s. sloganın k. hücresi: glif sırası, -1 boşluk, -2 son.
int sloganGlyph(int s, int k) { return int(floor(fetchA(2176 + s * 16 + k).x + 0.5)); }

// g glifinin glif uzayındaki p noktasına işaretli uzaklığı (içeride negatif).
// Sınır kutusundan uzaksa kutuya uzaklık döner: gerçek uzaklığın alt sınırı, gölge için yeterli.
// `reach`: bu uzaklığın ötesi umursanmaz (gölge yarıçapı), kutu dışı pikseller döngüye girmez.
float glyphSd(vec2 p, int g, float reach) {
    vec4 bb = bbox(g);
    float outside = max(max(bb.x - p.x, p.x - bb.z), max(bb.y - p.y, p.y - bb.w));
    if (outside > reach) return outside;
    vec3 m = meta(g);
    int s = int(m.x) * 3, n = int(m.y);
    float d = 1e9;
    int w = 0;
    for (int i = 0; i < n; i++) {
        vec2 A = pt(s + 3 * i), B = pt(s + 3 * i + 1), C = pt(s + 3 * i + 2);
        d = min(d, sdBezier(p, A, B, C));
        w += crossings(p, A, B, C);
    }
    return w != 0 ? -d : d;
}

// ---------- Yazı yerleşimi ----------
// Glifi (orijin pos, büyük harf yüksekliği h) çizip işaretli uzaklığı ekran birimine çevirir.
float place(vec2 uv, vec2 pos, float h, int g) {
    return glyphSd((uv - pos) / h, g, 0.03 / h) * h;
}

vec3 scene(vec2 uv, float aspect) {
    vec3 colA, colB, ink;
    theme(int(tema + 0.5), colA, colB, ink);

    float bw = 0.05;
    float px = 1.0 / iResolution.y;
    // Katman A: solda iç içe yuvarlak dikdörtgenler.
    vec2 cA = vec2(-0.30 * aspect, 0.02);
    float dA = sdRBox(uv, cA, vec2(0.11, 0.065), 0.04);
    vec3 colA_ = stack(dA, colA, bw, px);

    // Katman B: sağdan gelen pist; üstte durur, A'ya geniş gölge düşürür.
    vec2 cB = vec2(0.07 * aspect, 0.0);
    float R = 0.40, rc = 0.09;
    float dB = sdTrack(uv, cB, R);
    vec3 colB_ = stack(R - rc + dB, colB, bw, px);
    float dBo = max(dB, 0.0);
    colA_ *= 1.0 - 0.45 * exp(-dBo / 0.012) - 0.35 * exp(-dBo / 0.06);
    vec3 col = mix(colA_, colB_, clamp(-dB / px + 0.5, 0.0, 1.0));

    // Işık: sol üst aydınlık, kenarlar hafif vinyetli.
    col *= 1.0 + 0.10 * (uv.y - uv.x * 0.5);
    col *= 1.0 - 0.22 * dot(uv, uv);

    // ---------- Saat ----------
    float secs = iDate.w;
    int hour = int(floor(secs / 3600.0));
    int minute = int(floor(mod(secs, 3600.0) / 60.0));
    bool h24 = yirmidort >= 0.5;
    if (!h24) {
        hour = hour % 12;
        if (hour == 0) hour = 12;
    }
    int dg0 = hour / 10, dg1 = hour % 10, dg2 = minute / 10, dg3 = minute % 10;
    bool showD0 = h24 || dg0 > 0;

    float hc = 0.14 * boyut;   // rakam yüksekliği
    float hs = 0.066 * boyut;  // slogan büyük harf yüksekliği
    float gap = 0.045 * boyut;
    float blockH = hc + gap + hs;
    float x0 = cB.x - 0.29 * boyut;
    float yClock = blockH * 0.5 - hc;
    float yText = yClock - gap - hs;

    float cell = 0.95, colonW = meta(G_COLON).z;  // tablo hizalı rakam hücresi
    float dInk = 1e9;
    float x = x0;
    // Blok dışındaki pikseller glif döngüsüne hiç girmesin.
    float margin = 0.04;
    // Slogan saatten geniş olabilir: sağ sınır cömert.
    bool near = uv.x > x0 - margin && uv.x < x0 + max(4.0 * cell * hc + colonW * hc, 13.0 * hs) + margin
             && uv.y > yText - 0.03 - margin && uv.y < yClock + hc + margin;
    if (near) {
    // Her satır yalnızca kendi bandındaki piksellerde denenir.
    if (uv.y > yClock - 0.03 - margin) {
    if (showD0) { dInk = min(dInk, place(uv, vec2(x + (cell - meta(dg0).z) * 0.5 * hc, yClock), hc, dg0)); x += cell * hc; }
    dInk = min(dInk, place(uv, vec2(x + (cell - meta(dg1).z) * 0.5 * hc, yClock), hc, dg1)); x += cell * hc;
    dInk = min(dInk, place(uv, vec2(x, yClock), hc, G_COLON)); x += colonW * hc;
    dInk = min(dInk, place(uv, vec2(x + (cell - meta(dg2).z) * 0.5 * hc, yClock), hc, dg2)); x += cell * hc;
    dInk = min(dInk, place(uv, vec2(x + (cell - meta(dg3).z) * 0.5 * hc, yClock), hc, dg3));
    }

    // ---------- Slogan ----------
    float track = 0.02 * hs, space = 0.34 * hs;
    int s = int(soz + 0.5);
    // Sözü değiştir: seçilen sözden başlayıp sırayla ilerler. Gün de eklenir; yoksa her gün
    // aynı saatte aynı söz gelirdi (24 saat ve 144 on dakika 8'e tam bölünür).
    int dn = int(dongu + 0.5);
    int day = int(iDate.x) * 372 + int(iDate.y) * 31 + int(iDate.z);
    if (dn == 1) s += int(iDate.w / 600.0) + day * 3;
    else if (dn == 2) s += int(iDate.w / 3600.0) + day * 5;
    else if (dn == 3) s += day;
    s = s % 8;
    x = x0;
    for (int k = 0; k < 16; k++) {
        if (uv.y > yText + hs + margin) break;
        int g = sloganGlyph(s, k);
        if (g == -2) break;
        if (g == -1) { x += space; continue; }
        dInk = min(dInk, place(uv, vec2(x, yText), hs, g));
        x += meta(g).z * hs + track;
    }
    }

    // Yumuşak düşen gölge, sonra yazı.
    float sh = 1.0 - smoothstep(0.0, 0.022, dInk + 0.002);
    col *= 1.0 - 0.2 * sh;
    float inkA = 1.0 - smoothstep(-px * 0.5, px * 0.5, dInk);
    col = mix(col, ink, inkA);
    return col;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    float aspect = iResolution.x / iResolution.y;
    vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;
    vec3 col = scene(uv, aspect);

    // İnce film tanesi.
    col += (hash12(fragCoord) - 0.5) * 0.03 * tane;
    fragColor = vec4(col, 1.0);
}
