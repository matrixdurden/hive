                        return vec4(-0.0286, 0.0000, 1.0186, 1.0000);
                    }
                } else {
                    if (i < 27) {
                        return vec4(0.1000, 0.0000, 1.0514, 1.0000);
                    } else {
                        return vec4(0.0914, -0.0200, 1.0314, 1.0000);
                    }
                }
            } else {
                if (i < 30) {
                    if (i < 29) {
                        return vec4(0.1000, 0.0000, 1.0514, 1.0000);
                    } else {
                        return vec4(0.1000, 0.0000, 0.8600, 1.0000);
                    }
                } else {
                    if (i < 31) {
                        return vec4(-0.0029, 0.0000, 1.0571, 1.0000);
                    } else {
                        if (i < 32) {
                            return vec4(0.0486, -0.0200, 1.0286, 1.0200);
                        } else {
                            return vec4(0.1000, 0.0000, 0.8843, 1.0000);
                        }
                    }
                }
            }
        }
    }
}

